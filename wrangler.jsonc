{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sgolaunch",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "keep_vars": true,
  "send_email": [{ "name": "CONTACT_EMAIL" }],
  "ratelimits": [{ "name": "CONTACT_RATE_LIMIT", "namespace_id": "1429976530", "simple": { "limit": 3, "period": 60 } }],
  "observability": { "enabled": true }
}
